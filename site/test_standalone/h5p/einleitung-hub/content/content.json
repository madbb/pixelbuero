, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"color:#1F3A5F\">Eine Person fehlt noch. Frau Brandt ist unsere Kundin. Im Moment arbeiten wir für sie.</span></p>"}, "subContentId": "4f23e992-6420-5f1b-b03d-b56a5b62c9e8", "metadata": {"contentType": "Text", "license": "U", "title": "K01 F3 Sprechtext 8", "authors": [], "changes": [], "extraTitle": "K01 F3 Sprechtext 8"}}}, {"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 4, "y": 5.0, "width": 9.4, "height": 18.568, "action": {"library": "H5P.Image 1.1", "params": {"decorative": false, "contentName": "Bild", "expandImage": "Bild vergrößern", "minimizeImage": "Bild verkleinern", "file": {"path": "images/portrait_lenz_freundlich.png", "mime": "image/png", "copyright": {"license": "U"}, "width": 270, "height": 270}, "title": "", "alt": "Porträt Herr Lenz, freundlich"}, "subContentId": "96e3aa37-390e-575b-a5a6-806d1aad64f0", "metadata": {"contentType": "Image", "license": "U", "title": "K01 F3 Porträt 8", "authors": [], "changes": [], "extraTitle": "K01 F3 Porträt 8"}}}, {"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 14.0, "y": 25.768, "width": 80.0, "height": 18.568, "action": {"library": "H5P.Image 1.1", "params": {"decorative": true, "contentName": "Bild", "expandImage": "Bild vergrößern", "minimizeImage": "Bild verkleinern", "file": {"path": "images/blase_frau_brandt_2.png", "mime": "image/png", "copyright": {"license": "U"}, "width": 1024, "height": 120}, "title": "", "alt": ""}, "subContentId": "6053a484-fb4b-5379-a8cd-1f8a0ce09639", "metadata": {"contentType": "Image", "license": "U", "title": "K01 F3 Blase 9", "authors": [], "changes": [], "extraTitle": "K01 F3 Blase 9"}}}, {"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 17.6, "y": 31.668, "width": 74.8, "height": 9.6, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"color:#1F3A5F\">Hallo, ich bin Susanne Brandt vom Fitnessstudio Kraftwerk. Schön, dass du dabei bist.</span></p>"}, "subContentId": "8f513c2c-64fc-5c7f-9c6c-cb4eec91ffd9", "metadata": {"contentType": "Text", "license": "U", "title": "K01 F3 Sprechtext 9", "authors": [], "changes": [], "extraTitle": "K01 F3 Sprechtext 9"}}}, {"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 4, "y": 25.768, "width": 9.4, "height": 18.568, "action": {"library": "H5P.Image 1.1", "params": {"decorative": false, "contentName": "Bild", "expandImage": "Bild vergrößern", "minimizeImage": "Bild verkleinern", "file": {"path": "images/portrait_brandt.png", "mime": "image/png", "copyright": {"license": "U"}, "width": 270, "height": 270}, "title": "", "alt": "Porträt Frau Brandt"}, "subContentId": "8624d218-ff40-5fd7-bd6c-af5b5e06ba48", "metadata": {"contentType": "Image", "license": "U", "title": "K01 F3 Porträt 9", "authors": [], "changes": [], "extraTitle": "K01 F3 Porträt 9"}}}]}, {"keywords": [], "slideBackgroundSelector": {"imageSlideBackground": {"path": "images/hintergrund_ruhig.jpg", "mime": "image/jpeg", "copyright": {"license": "U"}, "width": 1280, "height": 720}}, "elements": [{"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 16, "y": 5, "width": 78, "height": 14.2, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<h2>So funktioniert das Büro</h2>"}, "subContentId": "06cdbd8e-c138-5647-9ca8-5790002f0316", "metadata": {"contentType": "Text", "license": "U", "title": "K01 F4 Ti
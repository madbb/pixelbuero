e": "", "subtitle": ""}, "contentBehaviour": "useBehavioural", "nextContentId": 1, "contentId": 0}, {"type": {"library": "H5P.CoursePresentation 1.25", "params": {"presentation": {"keywordListEnabled": true, "globalBackgroundSelector": {"fillGlobalBackground": ""}, "keywordListAlwaysShow": false, "keywordListAutoHide": false, "keywordListOpacity": 90, "slides": [{"keywords": [], "slideBackgroundSelector": {"fillSlideBackground": ""}, "elements": [{"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 58.31321085791986, "y": 5.235876223886067, "width": 40, "height": 40, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p>Ebene 1: Die Schatzkammer</p><p>Runa: Bevor wir losziehen, zählen wir unser Gold.</p>"}, "subContentId": "9a220ad2-1103-5a1f-b777-b574c668fe41", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": [], "extraTitle": "Untitled Text"}}}]}]}, "override": {"activeSurface": false, "hideSummarySlide": false, "summarySlideSolutionButton": true, "summarySlideRetryButton": true, "enablePrintButton": false, "social": {"showFacebookShare": false, "facebookShare": {"url": "@currentpageurl", "quote": "I scored @score out of @maxScore on a task at @currentpageurl."}, "showTwitterShare": false, "twitterShare": {"statement": "I scored @score out of @maxScore on a task at @currentpageurl.", "url": "@currentpageurl", "hashtags": "h5p, course"}, "showGoogleShare": false, "googleShareUrl": "@currentpageurl"}}, "l10n": {"slide": "Slide", "score": "Score", "yourScore": "Your Score", "maxScore": "Max Score", "total": "Total", "totalScore": "Total Score", "showSolutions": "Show solutions", "retry": "Retry", "exportAnswers": "Export text", "hideKeywords": "Hide sidebar navigation menu", "showKeywords": "Show sidebar navigation menu", "fullscreen": "Fullscreen", "exitFullscreen": "Exit fullscreen", "prevSlide": "Previous slide", "nextSlide": "Next slide", "currentSlide": "Current slide", "lastSlide": "Last slide", "solutionModeTitle": "Exit solution mode", "solutionModeText": "Solution Mode", "summaryMultipleTaskText": "Multiple tasks", "scoreMessage": "You achieved:", "shareFacebook": "Share on Facebook", "shareTwitter": "Share on Twitter", "shareGoogle": "Share on Google+", "summary": "Summary", "solutionsButtonTitle": "Show comments", "printTitle": "Print", "printIngress": "How would you like to print this presentation?", "printAllSlides": "Print all slides", "printCurrentSlide": "Print current slide", "noTitle": "No title", "accessibilitySlideNavigationExplanation": "Use left and right arrow to change slide in that direction whenever canvas is selected.", "accessibilityCanvasLabel": "Presentation canvas. Use left and right arrow to move between slides.", "accessibilityProgressBarLabel": "Choose slide to display", "containsNotCompleted": "@slideName contains not completed interaction", "containsCompleted": "@slideName contains completed interaction", "slideCount": "Slide @index of @total", "containsOnlyCorrect": "@slideName only has correct answers", "containsIncorrectAnswers": "@slideName has incorrect answers", "shareResult": "Share Result", "accessibilityTotalScore": "You got @score of @maxScore points in total", "accessibilityEnteredFullscreen": "Entered fullscreen", "accessibilityExitedFullscreen": "Exited fullscreen", "confirmDialogHeader": "Submit your answers", "confirmDialogText": "This will submit your results, do you want to continue?", "confirmDialogConfirmText": "Submit and see results", "slideshowNavigationLabel": "Slideshow navigation", "confirmDialogConfirmLabel": "Confirm", "confirmDialogCancelLabel": "Cancel"}}, "subContentId": "b802feda-ba55-56fe-9c88-3a538c508ac1", "metadata": {"contentType": "Course Presentation", "license": "U", "title": "Ebene 1", "authors": [], "changes": [], "extraTitle": "Ebene 1"}}, "showContentTitle": false, "proceedButtonText": "Proceed", "forceContentFinished": "useBehavioural", "feedback": {"title": "", "subtitle": ""}, "contentBehaviour": "useBehavioural", "nextContentId": 2, "contentId": 1}, {"type": {"library": "H5P.BranchingQuestion 1.0", "params": {"branchingQuestion": {"question": "<p>Euch fehlen 80.000 Euro. Wie geht es weiter?</p>", "alternatives": [{"text": "Einfach loslegen. Nach ein paar Monaten zeigen wir eine Demo und finden dann Geldgeber.", "nextContentId": 4, "feedback": {"title": "", "subtitle": "", "endScreenScore": 0}}, {"text": "Jetzt eine Finanzierung für die ganzen 18 Monate suchen.", "nextContentId": 3, "feedback": {"title": "<p>Kluger Zug</p>", "subtitle": "<p>Geldgeber brauchen oft Monate für eine Zusage. Wer früh sucht, hat Zeit zum Verhandeln.</p>", "endScreenScore": 3}}, {"text": "Kosten senken: Alle drei behalten einen Teilzeitjob und entwickeln nebenbei.", "nextContentId": 3, "feedback": {"title": "<p>Mehr Zeit, aber kein Ausweg.</p>", "subtitle": "<p>Das Studio zahlt nur noch halbe Gehälter und braucht 5.500 Euro im Monat. Das Geld reicht jetzt gut 18 Monate. Dafür dauert die Entwicklung doppelt so lange, und 36 Monate kosten zusammen 198.000 Euro. Die Lücke kommt nur später. Ihr sucht doch eine Finanzierung.</p>", "endScreenScore": 1}}]}, "proceedButtonText": "Weiter"}, "subContentId": "ba33d271-aaff-5ae0-86d6-ba3130a0fefa", "metadata": {"contentType": "Branching Question", "license": "U", "title": "Entscheidung 1.", "authors": [], "changes": [], "extraTitle": "Entscheidung 1."}}, "showContentTitle": false, "proceedButtonText": "Weiter", "forceContentFinished": "useBehavioural", "feedback": {"title": "", "subtitle": ""}, "contentBehaviour": "useBehavioural", "nextContentId": -1, "contentId": 2}, {"type": {"library": "H5P.CoursePresentation 1.25", "params": {"presentation": {"keywordListEnabled": true, "globalBackgroundSelector": {"fillGlobalBackground": ""}, "keywordListAlwaysShow": false, "keywordListAutoHide": false, "keywordListOpacity": 90, "slides": [{"keywords": [], "slideBackgroundSelector": {"fillSlideBackground": ""}, "elements": [{"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 2.6506004935418117, "y": 7.6809831658452286, "width": 40, "height": 40, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p>Ebene 2: Die Halle der Geldgeber</p><p>Runa: 80.000 Euro fehlen. Hier warten drei Geldquellen. Jede hat ihren Preis.</p>"}, "subContentId": "3c873e58-675d-5b60-9c24-8b4fae1ae988", "metadata": {"contentType": "Text", "license": "U", "title": "Ebene 2", "authors": [], "changes": [], "extraTitle": "Ebene 2"}}}]}]}, "override": {"activeSurface": false, "hideSummarySlide": false, "summarySlideSolutionButton": true, "summarySlideRetryButton": true, "enablePrintButton": false, "social": {"showFacebookShare": false, "facebookShare": {"url": "@currentpageurl", "quote": "I scored @score out of @maxScore on a task at @currentpageurl."}, "showTwitterShare": false, "twitterShare": {"statement": "I scored @score out of @maxScore on a task at @currentpageurl.", "url": "@currentpageurl", "hashtags": "h5p, course"}, "showGoogleShare": false, "googleShareUrl": "@currentpageurl"}}, "l10n": {"slide": "Slide", "score": "Score", "yourScore": "Your Score", "maxScore": "Max Score", "total": "Total", "totalScore": "Total Score", "showSolutions": "Show solutions", "retry": "Retry", "exportAnswers": "Export text", "hideKeywords": "Hide sidebar navigation menu", "showKeywords": "Show sidebar navigation menu", "fullscreen": "Fullscreen", "exitFullscreen": "Exit fullscreen", "prevSlide": "Previous slide", "nextSlide": "Next slide", "currentSlide": "Current slide", "lastSlide": "Last slide", "solutionModeTitle": "Exit solution mode", "solutionModeText": "Solution Mode", "summaryMultipleTaskText": "Multiple tasks", "scoreMessage": "You achieved:", "shareFacebook": "Share on Facebook", "shareTwitter": "Share on Twitter", "shareGoogle": "Share on Google+", "summary": "Summary", "solutionsButtonTitle": "Show comments", "printTitle": "Print", "printIngress": "How would you like to print this presentation?", "printAllSlides": "Print all slides", "printCurrentSlide": "Print current slide", "noTitle": "No title", "accessibilitySlideNavigationExplanation": "Use left and right arrow to change slide in that direction whenever canvas is selected.", "accessibilityCanvasLabel": "Presentation canvas. Use left and right arrow to move between slides.", "accessibilityProgressBarLabel": "Choose slide to display", "containsNotCompleted": "@slideName contains not completed interaction", "containsCompleted": "@slideName contains completed interaction", "slideCount": "Slide @index of @total", "containsOnlyCorrect": "@slideName only has correct answers", "containsIncorrectAnswers": "@slideName has incorrect answers", "shareResult": "Share Result", "accessibilityTotalScore": "You got @score of @maxScore points in total", "accessibilityEnteredFullscreen": "Entered fullscreen", "accessibilityExitedFullscreen": "Exited fullscreen", "confirmDialogHeader": "Submit your answers", "confirmDialogText": "This will submit your results, do you want to continue?", "confirmDialogConfirmText": "Submit and see results", "slideshowNavigationLabel": "Slideshow navigation", "confirmDialogConfirmLabel": "Confirm", "confirmDialogCancelLabel": "Cancel"}}, "subContentId": "47413a7e-0fac-5d60-92c0-ff75d322e455", "metadata": {"contentType": "Course Presentation", "license": "U", "title": "Ebene 2", "authors": [], "changes": [], "extraTitle": "Ebene 2"}}, "showContentTitle": false, "proceedButtonText": "Proceed", "forceContentFinished": "useBehavioural", "feedback": {"title": "", "subtitle": ""}, "contentBehaviour": "useBehavioural", "nextContentId": 5, "contentId": 3}, {"type": {"library": "H5P.CoursePresentation 1.25", "params": {"presentation": {"keywordListEnabled": true, "globalBackgroundSelector": {"fillGlobalBackground": ""}, "keywordListAlwaysShow": false, "keywordListAutoHide": false, "keywordListOpacity": 90, "slides": [{"keywords": [], "slideBackgroundSelector": {"fillSlideBackground": ""}, "elements": [{"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 1.3253002467709059, "y": 7.8538143358291, "width": 55.66261036437805, "height": 57.59463846274674, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p>Game Over: Das Konto ist leer</p><p>Im achten Monat steht eine Demo. Zwei Publisher sind interessiert, aber ihre Prüfung dauert Monate. Im zehnten Monat ist das Konto leer, und ihr müsst aufgeben, bevor ein Vertrag unterschrieben ist.</p><p>Die Lehre: Plane die Finanzierung, bevor das Geld knapp wird. Mit Reserven verhandelst du aus einer stärkeren Position.</p><p>Runa: Ich bleibe eine Skizze … Versuch es noch einmal!</p>"}, "subContentId": "a58573ff-b463-51a1-971d-960c552f63ff", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": [], "extraTitle": "Untitled Text"}}}]}]}, "override": {"activeSurface": false, "hideSummarySlide": false, "summarySlideSolutionButton": true, "summarySlideRetryButton": true, "enablePrintButton": false, "social": {"showFacebookShare": false, "facebookShare": {"url": "@currentpageurl", "quote": "I scored @score out of @maxScore on a task at @currentpageurl."}, "showTwitterShare": false, "twitterShare": {"statement": "I scored @score out of @maxScore on a task at @currentpageurl.", "url": "@currentpageurl", "hashtags": "h5p, course"}, "showGoogleShare": false, "googleShareUrl": "@currentpageurl"}}, "l10n": {"slide": "Slide", "score": "Score", "yourScore": "Your Score", "maxScore": "Max Score", "total": "Total", "totalScore": "Total Score", "showSolutions": "Show solutions", "retry": "Retry", "exportAnswers": "Export text", "hideKeywords": "Hide sidebar navigation menu", "showKeywords": "Show sidebar navigation menu", "fullscreen": "Fullscreen", "exitFullscreen": "Exit fullscreen", "prevSlide": "Previous slide", "nextSlide": "Next slide", "currentSlide": "Current slide", "lastSlide": "Last slide", "solutionModeTitle": "Exit solution mode", "solutionModeText": "Solution Mode", "summaryMultipleTaskText": "Multiple tasks", "scoreMessage": "You achieved:", "shareFacebook": "Share on Facebook", "shareTwitter": "Share on Twitter", "shareGoogle": "Share on Google+", "summary": "Summary", "solutionsButtonTitle": "Show comments", "printTitle": "Print", "printIngress": "How would you like to print this presentation?", "printAllSlides": "Print all slides", "printCurrentSlide": "Print current slide", "noTitle": "No title", "accessibilitySlideNavigationExplanation": "Use left and right arrow to change slide in that direction whenever canvas is selected.", "accessibilityCanvasLabel": "Presentation canvas. Use left and right arrow to move between slides.", "accessibilityProgressBarLabel": "Choose slide to display", "containsNotCompleted": "@slideName contains not completed interaction", "containsCompleted": "@slideName contains completed interaction", "slideCount": "Slide @index of @total", "containsOnlyCorrect": "@slideName only has correct answers", "containsIncorrectAnswers": "@slideName has incorrect answers", "shareResult": "Share Result", "accessibilityTotalScore": "You got @score of @maxScore points in total", "accessibilityEnteredFullscreen": "Entered fullscreen", "accessibilityExitedFullscreen": "Exited fullscreen", "confirmDialogHeader": "Submit your answers", "confirmDialogText": "This will submit your results, do you want to continue?", "confirmDialogConfirmText": "Submit and see results", "slideshowNavigationLabel": "Slideshow navigation", "confirmDialogConfirmLabel": "Confirm", "confirmDialogCancelLabel": "Cancel"}}, "subContentId": "4487e961-6b21-5920-8bec-effd6a77936a", "metadata": {"contentType": "Course Presentation", "license": "U", "title": "Game Over Screen A1", "authors": [], "changes": [], "extraTitle": "Game Over Screen A1"}}, "showContentTitle": false, "proceedButtonText": "Proceed", "forceContentFinished": "useBehavioural", "feedback": {"title": "", "subtitle": ""}, "contentBehaviour": "useBehavioural", "nextContentId": 1, "contentId": 4}, {"type": {"library": "H5P.BranchingQuestion 1.0", "params": {"branchingQuestion": {"question": "<p>Welche Finanzierung wählst du?</p>", "alternatives": [{"text": "Publisher Steinbrücke", "nextContentId": 6, "feedback": {"title": "<p>Sicher, aber teuer.</p>", "subtitle": "<p>Das Geld ist da, und um das Marketing kümmern sich Profis. Dafür gehen die ersten Einnahmen komplett an den Publisher und danach nur noch die Hälfte an euch. In Ebene 4 rechnest du aus, was das bedeutet.</p>", "endScreenScore": 2}}, {"text": "Kickstarter mit einem Ziel von 80.000 Euro", "nextContentId": 6, "feedback": {"title": "<p>Ziel erreicht, Geld fehlt trotzdem.</p>", "subtitle": "<p>Nach Gebühren kommen 73.200 Euro an, die gedruckten Artbooks kosten rund 5.000 Euro. Es fehlen fast 12.000 Euro, und ihr leiht sie euch bei der Familie. Die Lehre: Gebühren und Belohnungen gehören ins Kampagnenziel.</p>", "endScreenScore": 0}}, {"text": "Kickstarter mit einem Ziel von 95.000 Euro.", "nextContentId": 6, "feedback": {"title": "<p>Gut gerechnet.</p>", "subtitle": "<p>Die Kampagne erreicht 95.000 Euro. Nach Gebühren bleiben 86.925 Euro, nach den Artbooks gut 80.000 Euro. Dazu habt ihr schon fast 2.400 Fans. Aber Vorsicht: Jeder Unterstützer hat das Spiel schon und kauft es beim Release nicht mehr. Und ein höheres Ziel kann auch scheitern</p>", "endScreenScore": 2}}, {"text": "Bankkredit", "nextContentId": 6, "feedback": {"title": "<p>Volles Risiko.</p>", "subtitle": "<p>Alle Einnahmen gehören euch. Die Rate von rund 2.470 Euro ist aber jeden Monat fällig, auch wenn sich das Spiel schlecht verkauft. Weil ihr persönlich haftet, steht im schlimmsten Fall euer Privatvermögen auf dem Spiel. Für ein erstes Spiel ohne Erfahrungswerte ist das viel Risiko.</p>", "endScreenScore": 1}}]}, "proceedButtonText": "Proceed"}, "subContentId": "6a2d3cfa-b227-5db0-a37e-7915da91e40c", "metadata": {"contentType": "Branching Question", "license": "U", "title": "Entscheidung 2", "authors": [], "changes": [], "extraTitle": "Entscheidung 2"}}, "showContentTitle": false, "proceedButtonText": "Proceed", "forceContentFinished": "useBehavioural", "feedback": {"title": "", "subtitle": ""}, "contentBehaviour": "useBehavioural", "nextContentId": -1, "contentId": 5}, {"type": {"library": "H5P.CoursePresentation 1.25", "params": {"presentation": {"keywordListEnabled": true, "globalBackgroundSelector": {"fillGlobalBackground": ""}, "keywordListAlwaysShow": false, "keywordListAutoHide": false, "keywordListOpacity": 90, "slides": [{"keywords": [], "slideBackgroundSelector": {"fillSlideBackground": ""}, "elements": [{"alwaysDisplayComments": false, "backgroundOpacity": 0, "displayAsButton": false, "buttonSize": "big", "goToSlideType": "specified", "invisible": false, "solution": "", "x": 2.6506004935418117, "y": 7.8538143358291, "width": 40, "height": 40, "action": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p>Ebene 3: Der frühe Zugang</p><p>Runa: Monat 12. Ich kann schon laufen, kämpfen und drei Dungeons erkunden. Zeigen wir mich der Welt?</p>"}, "subContentId": "4852cbe4-2103-5221-8f82-d91eae9b3d7c", "metadata": {"contentType": "Text", "license": "U", "title": "Ebene 3", "authors": [], "changes": [], "extraTitle": "Ebene 3"}}}]}]}, "override": {"activeSurface": false, "hideSummarySlide": false, "summarySlideSolutionButton": true, "summarySlideRetryButton": true, "enablePrintButton": false, "social": {"showFacebookShare": false, "facebookShare": {"url": "@currentpageurl", "quote": "I scored @score out of @maxScore on a task at @currentpageurl."}, "showTwitterShare": false, "twitterShare": {"statement": "I scored @score o